# .env.example — modelo das variaveis de ambiente. ESTE arquivo VAI para o git.
# Copie para .env e preencha os valores (o .env real fica fora do git).
#   cp .env.example .env

# --- Banco de dados (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommercie
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
# Gere um segredo forte (min. 256 bits):  openssl rand -base64 48
JWT_SECRET=

# --- CORS (origem do front Angular futuro) ---
CORS_ORIGIN=http://localhost:4200
