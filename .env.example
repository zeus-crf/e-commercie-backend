# .env.example — modelo das variaveis de ambiente. ESTE arquivo VAI para o git.
# Copie para .env e preencha os valores (o .env real fica fora do git).
#   cp .env.example .env
#
# NENHUM valor real aqui. Se voce colar um token neste arquivo, ele vai para o repositorio.
#
# O Spring NAO le o .env sozinho. Para rodar local:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# Na IDE, use a run configuration ou o plugin EnvFile.

# --- Banco de dados (Postgres) --- OBRIGATORIO
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommercie
DB_USER=postgres
DB_PASSWORD=

# --- JWT --- OBRIGATORIO (sem default: a app nao sobe sem isso)
# Gere um segredo forte (min. 256 bits):  openssl rand -base64 48
JWT_SECRET=

# --- CORS (origem do front Angular futuro) ---
CORS_ORIGIN=http://localhost:4200

# --- Mercado Pago --- OBRIGATORIO
# Token da conta do LOJISTA. Em sandbox, use a conta Vendedor de teste.
MP_ACCESS_TOKEN=
# URL publica que o MP chama no pagamento. Em dev, o tunel (ngrok) aponta para /api/v1/webhooks/mercadopago
MP_NOTIFICATION_URL=

# --- Melhor Envio --- OBRIGATORIO
ME_TOKEN=
SHIPPING_ORIGIN_CEP=
# O ME exige User-Agent com e-mail de contato: use o do LOJISTA, nunca o do dev
ME_USER_AGENT=ecommercie/1.0 contato@exemplo.com
ME_BASE_URL=https://sandbox.melhorenvio.com.br

# --- E-mail transacional ---
# Em dev, um Mailpit local na 1025 resolve:  docker start mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@ecommercie.local

# --- Fiscal / NF-e (Focus NFe) --- nasce DESLIGADO
# So ligue depois que o cliente entregar CNPJ, certificado e token do provedor.
FISCAL_ENABLED=false
FISCAL_TIPO=DCE
FOCUSNFE_TOKEN=
FOCUSNFE_BASE_URL=https://homologacao.focusnfe.com.br
FOCUSNFE_CNPJ=
FOCUSNFE_IE=
FOCUSNFE_UF=
FOCUSNFE_REGIME=1
FOCUSNFE_ICMS_CST=102
FOCUSNFE_PIS_CST=07
FOCUSNFE_COFINS_CST=07
FOCUSNFE_TIPO_EMITENTE=2
FOCUSNFE_MODALIDADE_TRANSPORTE=0
